generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Analysis {
  id             String   @id @default(cuid())
  url            String
  status         String   @default("pending")
  error          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  screenshotUrl  String?
  overallScore   Float?
  pageTitle      String?

  technologies   Technology[]
  lighthouse     LighthouseResult?
  fonts          DetectedFont[]
  colors         ColorPalette?
  designSystem   DesignSystem?
  aiSummary      AISummary?
  architecture   Architecture?
}

model Technology {
  id         String   @id @default(cuid())
  analysisId String
  name       String
  category   String
  version    String?
  icon       String?
  confidence Float

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
}

model LighthouseResult {
  id            String  @id @default(cuid())
  analysisId    String  @unique
  performance   Float?
  accessibility Float?
  seo           Float?
  bestPractices Float?
  lcp           Float?
  fid           Float?
  cls           Float?
  raw           String?

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

model DetectedFont {
  id         String @id @default(cuid())
  analysisId String
  family     String
  category   String
  variants   Int    @default(1)

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
}

model ColorPalette {
  id         String @id @default(cuid())
  analysisId String @unique
  primary    String
  secondary  String?
  accent     String?
  background String?
  text       String?
  palette    String?

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

model DesignSystem {
  id              String  @id @default(cuid())
  analysisId      String  @unique
  hasDesignSystem Boolean @default(false)
  framework       String?
  components      Int?
  tokens          String?
  analysis         Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

model AISummary {
  id         String  @id @default(cuid())
  analysisId String  @unique
  summary    String
  insights   String?
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

model Architecture {
  id         String @id @default(cuid())
  analysisId String @unique
  type       String?
  diagram    String?
  hosting    String?
  cdn        String?
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}
